	(text ".title GC9A01 RC power-on reset (R1 10k / C2 1u)\n.param td3=1u tr3=5m tdi=1u tri=5m\n.param tcyc=1 tf=1m toff=50m\n.tran 10u 300m"
		(exclude_from_sim no)
		(at 38.10 30.48 0)
