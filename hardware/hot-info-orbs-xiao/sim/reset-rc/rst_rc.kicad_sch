		(uuid "f7e85c04-6a9d-4363-898a-689131d40605")
	)
	(text "3V3   = XIAO 3V3_OUT, feeds R1 (the pull-up)\nIOVCC = the display module's own 3.3 V, made from +5V by the module regulator\n        (the GC9A01 VCC pin is on +5V, not 3V3)\nI1    = 5 x IIH max 1 uA (GC9A01A DC table): worst case for release\nRST_ASSERTED = 1 while the panels are actually held in reset"
		(exclude_from_sim no)
		(at 38.10 114.30 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
